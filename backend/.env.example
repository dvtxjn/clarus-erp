# Copy to .env and fill in for local/production use.
# Falls back to a local SQLite file if DATABASE_URL is unset, so the app
# runs immediately without Postgres for local dev.

DATABASE_URL=postgresql://user:password@localhost:5432/erp_db
JWT_SECRET_KEY=change-me-to-a-long-random-string
DOCUMENT_STORAGE_ROOT=./storage/documents
