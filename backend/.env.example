# Copy to .env and fill in for local/production use.
# Falls back to a local SQLite file if DATABASE_URL is unset.

# Local Postgres (Postgres.app, or `docker compose up -d` from erp-app/)
DATABASE_URL=postgresql://erp:erp-local-only@localhost:5432/erp_db
# Tests only — this database is wiped on every run. Must contain "test" in its name.
TEST_DATABASE_URL=postgresql://erp:erp-local-only@localhost:5432/erp_test
JWT_SECRET_KEY=change-me-to-a-long-random-string
DOCUMENT_STORAGE_ROOT=./storage/documents

# --- Google Drive storage (launch Phase 7) ---
# local (default) = files stay on this machine only; drive = also saved in the Shared Drive
STORAGE_BACKEND=local
# the service account key: a path to the .json file (kept in backend/secrets/, gitignored) or its JSON text
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
# folder IDs inside the "Clarus ERP" Shared Drive (the part after /folders/ in the address bar)
DRIVE_ROOT_FOLDER_ID=
DRIVE_INVOICES_FOLDER_ID=
DRIVE_BACKUPS_FOLDER_ID=
# background jobs (Drive retry, backups): 0 turns them off
JOBS_ENABLED=1
